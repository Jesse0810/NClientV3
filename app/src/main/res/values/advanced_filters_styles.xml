<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.NClient.AdvancedFilter.Field" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Subtitle1</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="cornerRadius">10dp</item>
        <item name="icon">@drawable/ic_keyboard_arrow_right</item>
        <item name="iconGravity">end</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.NClient.AdvancedFilter.Keyword" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorControlNormal</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.NClient.AdvancedFilter.Section" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
